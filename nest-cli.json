{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [{ "include": "database/migrations/*.sql", "watchAssets": true }, { "include": "database/data/*.json", "watchAssets": true }]
  }
}
