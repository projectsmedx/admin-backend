PORT=4000
# Required. Local docker database: postgres://medx:<POSTGRES_PASSWORD>@localhost:5433/medx_hr
DATABASE_URL=
# Password for the local PostgreSQL container (docker-compose.yml)
POSTGRES_PASSWORD=
FRONTEND_URL=http://localhost:3000
# Required. Generate one with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
# COOKIE_DOMAIN=.medxpharmacy.com

# Creates/updates tables on start, then seeds demo data when the database is empty
RUN_MIGRATIONS=true
SEED_ON_START=true
# Required when seeding: password for every demo account
SEED_PASSWORD=
# Initial password for new logins when HR leaves it blank (empty = HR must enter one)
DEFAULT_USER_PASSWORD=
# SEED_DATE=2026-10-01   # anchor demo data to a fixed date (defaults to today)

# Email (local: Mailpit from docker compose → http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Domain for auto-generated employee work emails
COMPANY_EMAIL_DOMAIN=medxpharmacy.com
MAIL_FROM=MedxDashboard <hr@medxpharmacy.com>

# File storage. Set SUPABASE_URL to store files in Supabase Storage; leave it empty to use UPLOAD_DIR on disk.
SUPABASE_URL=
# Server-only secret: Supabase → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
MAX_UPLOAD_MB=50
# Used only when SUPABASE_URL is empty (local development)
UPLOAD_DIR=./uploads
