PORT=4000
DATABASE_URL=postgres://medx:medx@localhost:5433/medx_hr
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
# COOKIE_DOMAIN=.medxpharmacy.com

# Creates/updates tables on start, then seeds demo data when the database is empty
RUN_MIGRATIONS=true
SEED_ON_START=true
# SEED_DATE=2026-10-01   # anchor demo data to a fixed date (defaults to today)

# Email (local: Mailpit from docker compose → http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=MedxDashboard <hr@medxpharmacy.com>

UPLOAD_DIR=./uploads
